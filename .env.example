# @BotFather에서 생성한 봇 토큰. 실제 값은 저장소에 올리지 마세요.
TELEGRAM_BOT_TOKEN=
# 만든 봇에 /start를 보낸 뒤 python -m reportbot telegram-setup으로 확인합니다.
TELEGRAM_CHAT_ID=

# 선택 사항: Google AI Studio에서 만든 Gemini API 키. 없으면 PDF만 보냅니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SUMMARY_MODE=auto

STATE_PATH=data/state.sqlite3
MIN_PDF_PAGES=20
MAX_LIST_PAGES=100
SCAN_LOOKBACK_DAYS=45
POLL_SECONDS=86400
